{
  "description": "Send session events to the crittersdeck board.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-o",
              "${CLAUDE_PLUGIN_DATA}/last-response",
              "-fsS",
              "--max-time",
              "8",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "--variable",
              "%CLAUDE_PLUGIN_OPTION_TOKEN",
              "--expand-header",
              "Authorization: Bearer {{CLAUDE_PLUGIN_OPTION_TOKEN}}",
              "--data-binary",
              "@-",
              "--url",
              "${user_config.ingest_url}/ingest"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-o",
              "${CLAUDE_PLUGIN_DATA}/last-response",
              "-fsS",
              "--max-time",
              "8",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "--variable",
              "%CLAUDE_PLUGIN_OPTION_TOKEN",
              "--expand-header",
              "Authorization: Bearer {{CLAUDE_PLUGIN_OPTION_TOKEN}}",
              "--data-binary",
              "@-",
              "--url",
              "${user_config.ingest_url}/ingest"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-o",
              "${CLAUDE_PLUGIN_DATA}/last-response",
              "-fsS",
              "--max-time",
              "8",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "--variable",
              "%CLAUDE_PLUGIN_OPTION_TOKEN",
              "--expand-header",
              "Authorization: Bearer {{CLAUDE_PLUGIN_OPTION_TOKEN}}",
              "--data-binary",
              "@-",
              "--url",
              "${user_config.ingest_url}/ingest"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [

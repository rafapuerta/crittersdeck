              "8",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "--variable",
              "%CLAUDE_PLUGIN_OPTION_TOKEN",
              "--expand-header",
              "Authorization: Bearer {{CLAUDE_PLUGIN_OPTION_TOKEN}}",
              "--data-binary",
              "@-",
              "--url",
              "${user_config.ingest_url}/ingest"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-fsS",
              "--max-time",
              "86400",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "--variable",
              "%CLAUDE_PLUGIN_OPTION_TOKEN",
              "--expand-header",
              "Authorization: Bearer {{CLAUDE_PLUGIN_OPTION_TOKEN}}",
              "--data-binary",
              "@-",
              "--url",
              "${user_config.ingest_url}/ingest"
            ],
            "timeout": 86400
          }
        ]
      }
    ],
    "Notification": [

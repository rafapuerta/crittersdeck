{
  "description": "Send the title Claude gives each session to the crittersdeck board.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/titles.py",
              "${user_config.ingest_url}"
            ],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/titles.py",
              "${user_config.ingest_url}"
            ],
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
